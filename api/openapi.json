{
  "openapi": "3.1.0",
  "info": {
    "title": "Deployer control-plane API",
    "version": "0.1.0-dev.3",
    "description": "Authenticated projects, tokens, operations, deployments, and reusable GitHub App connections. JSON bodies are limited to 64 KiB. Healthz and short-lived GitHub browser setup/callback routes are anonymous; setup links can only be minted by an administrator."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7420"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Non-sensitive process readiness",
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "const": "ok"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema_version",
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 invalid token, 403 missing scope, 404 absent/inaccessible resource, 409 conflict, 429 queue full, 500 internal failure, 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/server": {
      "get": {
        "summary": "Server capabilities; requires server:read",
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "const": "deployer"
                        },
                        "version": {
                          "type": "string"
                        },
                        "api_version": {
                          "const": 1
                        },
                        "base_domain": {
                          "type": "string"
                        },
                        "capabilities": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "deployment_runtime": {
                          "enum": [
                            "disabled",
                            "docker"
                          ]
                        }
                      },
                      "required": [
                        "name",
                        "version",
                        "api_version",
                        "base_domain",
                        "capabilities",
                        "deployment_runtime"
                      ]
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema_version",
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 invalid token, 403 missing scope, 404 absent/inaccessible resource, 409 conflict, 429 queue full, 500 internal failure, 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects": {
      "get": {
        "summary": "List projects visible to this token; requires projects:read",
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema_version",
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 invalid token, 403 missing scope, 404 absent/inaccessible resource, 409 conflict, 429 queue full, 500 internal failure, 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register a project; requires projects:write and wildcard project grant",
        "responses": {
          "201": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "data": {
                      "$ref": "#/components/schemas/Project"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema_version",
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 invalid token, 403 missing scope, 404 absent/inaccessible resource, 409 conflict, 429 queue full, 500 internal failure, 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "repository": {
                    "type": "string",
                    "description": "Credential-free HTTPS or git SSH repository URL."
                  }
                },
                "required": [
                  "name",
                  "repository"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/v1/projects/{id}": {
      "get": {
        "summary": "Inspect a project by ID or name; requires projects:read",
