    "/v1/deployments/{id}/actions/{action}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "enum": [
              "stop",
              "wake",
              "extend",
              "destroy"
            ]
          }
        }
      ],
      "post": {
        "summary": "Queue lifecycle action; requires deployments:write. Extend requires seconds and an active lease; other actions use an empty object. CLI destroy also requires --yes.",
        "responses": {
          "202": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "data": {
                      "$ref": "#/components/schemas/Operation"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema_version",
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 invalid token, 403 missing scope, 404 absent/inaccessible resource, 409 conflict, 429 queue full, 500 internal failure, 503 unavailable.",
