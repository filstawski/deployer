            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Identity saved; redirect to GitHub app installation"
          },
          "400": {
            "description": "Invalid state or browser binding"
          },
          "403": {
            "description": "Administrator token no longer active"
          },
