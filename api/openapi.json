  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "error",
          "request_id"
        ]
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "repository",
          "created_at"
        ]
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "scopes",
          "projects",
          "created_at",
          "revoked"
        ]
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "project.verify",
              "deployment.create",
              "deployment.stop",
              "deployment.wake",
              "deployment.extend",
              "deployment.destroy"
            ]
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "deployment_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "actor",
          "project_id",
          "kind",
          "status",
          "attempts",
          "created_at",
          "updated_at",
          "deadline"
        ]
      },
      "Deployment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "health_path": {
            "type": "string"
          },
          "health_timeout": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "building",
              "starting",
              "running",
              "stopped",
              "expired",
              "failed",
              "destroying",
              "destroyed"
            ]
          },
          "port": {
            "type": "integer"
          },
          "ttl_seconds": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "purge_at": {
            "type": "string",
            "format": "date-time"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "id",
          "project_id",
          "ref",
          "hostname",
          "url",
          "state",
          "ttl_seconds",
          "created_at",
          "operation_id",
          "deadline"
        ]
      }
    }
  }
}
