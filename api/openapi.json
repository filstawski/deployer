          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "project": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "string"
                  },
                  "subdomain": {
                    "type": "string"
                  },
                  "ttl_seconds": {
                    "type": "integer",
