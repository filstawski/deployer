    "/v1/github/setup/{state}": {
      "get": {
        "security": [],
        "summary": "Browser setup page; requires unexpired administrator-issued capability",
        "parameters": [
          {
            "name": "state",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML form for GitHub App creation; sets secure HttpOnly SameSite cookie"
          },
          "400": {
            "description": "Invalid, expired, consumed, or in-progress setup"
          },
          "403": {
            "description": "Initiating administrator token expired or revoked"
          }
        }
      }
    },
    "/v1/github/callback": {
      "get": {
        "security": [],
        "summary": "Complete GitHub App manifest registration; requires state and browser cookie",
        "parameters": [
