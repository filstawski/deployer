          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/v1/tokens": {
      "get": {
        "summary": "List non-secret token metadata; requires admin",
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Token"
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema_version",
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 invalid token, 403 missing scope, 404 absent/inaccessible resource, 409 conflict, 429 queue full, 500 internal failure, 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a scoped token; secret is returned once; requires admin",
        "responses": {
          "201": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "token": {
                          "$ref": "#/components/schemas/Token"
                        },
                        "secret": {
                          "type": "string",
                          "pattern": "^dpl_[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "token",
                        "secret"
                      ]
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema_version",
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 invalid token, 403 missing scope, 404 absent/inaccessible resource, 409 conflict, 429 queue full, 500 internal failure, 503 unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "scopes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": [
                        "admin",
                        "server:read",
                        "projects:read",
                        "projects:write"
                      ]
                    }
                  },
                  "projects": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "description": "Existing project ID or *; admin requires exactly [*]."
                    }
                  },
                  "ttl_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31536000
                  }
                },
                "required": [
                  "name",
                  "scopes",
                  "projects",
                  "ttl_seconds"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/tokens/{id}": {
      "delete": {
        "summary": "Revoke a token; requires admin",
        "responses": {
          "200": {
            "description": "Successful result",
