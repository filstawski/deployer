                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 invalid token, 403 missing scope, 404 absent/inaccessible resource, 409 conflict, 429 queue full, 500 internal failure, 503 unavailable.",
